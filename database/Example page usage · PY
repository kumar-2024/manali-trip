import streamlit as st
from database.connection import get_collection

st.title("Member List")

# Collection seedha lelo — bas ek line
members_col = get_collection("members")

if members_col is not None:

    # ---- INSERT (form submit pe) ----
    with st.form("add_member"):
        name = st.text_input("Name")
        age  = st.number_input("Age", min_value=1)
        if st.form_submit_button("Add Member"):
            members_col.insert_one({"name": name, "age": age})
            st.success(f"{name} add ho gaya!")

    # ---- READ (saare members dikhao) ----
    st.subheader("All Members")
    members = list(members_col.find({}, {"_id": 0}))  # _id hide karo
    if members:
        st.dataframe(members)
    else:
        st.info("Koi member nahi mila.")

    # ---- DELETE ----
    del_name = st.text_input("Delete karna hai to name likho")
    if st.button("Delete"):
        result = members_col.delete_one({"name": del_name})
        if result.deleted_count:
            st.success("Delete ho gaya!")
        else:
            st.warning("Name nahi mila.")